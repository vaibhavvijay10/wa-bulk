{
  "manifest_version": 3,
  "name": "WA Bulk Sender",
  "version": "1.0.0",
  "description": "Send personalised WhatsApp messages to a pasted list or an Excel sheet, straight from WhatsApp Web. Works with numbers that are not saved in your phone.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open WA Bulk Sender",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["vendor/wppconnect-wa.js", "page/bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["vendor/xlsx.full.min.js", "content/lib.js", "content/panel.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "111"
}
