# Copy to .env and edit.

# Public hostname that points at this VPS (A record). Caddy gets an HTTPS cert for it automatically.
# If you don't have a domain yet, use  http://YOUR.VPS.IP  (Caddy will serve plain HTTP on port 80).
DOMAIN=wa.example.com

# First admin login (only used the very first time the database is created).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now

# Timezone for daily caps / send windows
TZ=Asia/Kolkata

# Set to 1 to run without a real WhatsApp (for trying the UI on a laptop).
WA_MOCK=0

# Port for the web app (Windows / no-Docker runs)
PORT=3000

# Set to 1 to show the hidden WhatsApp Web browser window (debugging only)
WA_HEADFUL=0
