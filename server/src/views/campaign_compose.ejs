<%- include('partials/header', { title: 'Compose campaign' }) %>
<h1>New campaign — step 2 of 2: compose</h1>
<% if (error) { %><div class="err"><%= error %></div><% } %>
<form method="post" action="/campaigns/create" enctype="multipart/form-data" id="composeForm">
<input type="hidden" name="sheetId" value="<%= sheetId %>">
<input type="hidden" name="tz_offset" id="tzOffset" value="">
<div class="grid c2">
  <div>
    <div class="card">
      <h2>Contacts: <%= sheet.filename %> <span class="muted">(<%= sheet.rows.length %> rows)</span></h2>
      <label>Phone number column</label>
      <select name="phoneColumn" id="phoneColumn">
        <% for (const col of sheet.columns) { %><option value="<%= col %>" <%= col === phoneColumn ? 'selected' : '' %>><%= col %></option><% } %>
      </select>
      <div class="tbl-wrap" style="margin-top:10px"><table>
        <tr><% for (const col of sheet.columns) { %><th><%= col %></th><% } %></tr>
        <% for (const r of preview) { %><tr><% for (const col of sheet.columns) { %><td><%= r[col] %></td><% } %></tr><% } %>
      </table></div>
    </div>

    <div class="card">
      <h2>Message</h2>
      <label>Campaign name</label>
      <input type="text" name="name" placeholder="e.g. Weekend reload bonus – Sept">
      <label>Text <small>— click a field to insert it</small></label>
      <div class="chips" id="chips">
        <% for (const col of sheet.columns) { if (col !== phoneColumn) { %><span class="chip" data-ins="{{<%= col %>}}">{{<%= col %>}}</span><% } } %>
        <span class="chip" data-ins="{{Hi|Hello|Hey}}" title="Spintax: one option is picked at random per message">{{Hi|Hello|Hey}}</span>
      </div>
      <textarea name="template" id="template" placeholder="{{Hi|Hello}} {{name}}, ..."></textarea>
      <div class="help">Use <span class="mono">{{name}}</span> for a column, <span class="mono">{{name|there}}</span> for a fallback when the cell is empty, and <span class="mono">{{Hi|Hello|Hey}}</span> to rotate wording (helps avoid identical messages). *bold*, _italic_, ~strike~ work as in WhatsApp.</div>
      <label>Attachment <small>(optional — image, PDF, video; the text above becomes the caption)</small></label>
      <input type="file" name="attachment" accept="image/*,application/pdf,video/mp4,.doc,.docx,.xlsx">
    </div>

    <div class="card">
      <h2>Live preview <span class="muted">(first 3 contacts)</span></h2>
      <div class="preview" id="preview"><span class="muted">Type a message to preview it.</span></div>
      <div id="unknown" class="help"></div>
    </div>
  </div>

  <div>
    <div class="card">
      <h2>Sending pace</h2>
      <div class="row">
        <div><label>Min delay <small>(sec)</small></label><input type="number" name="delay_min" value="<%= defaults.delay_min %>" min="3"></div>
        <div><label>Max delay <small>(sec)</small></label><input type="number" name="delay_max" value="<%= defaults.delay_max %>" min="3"></div>
      </div>
      <div class="row">
        <div><label>Batch size <small>(msgs)</small></label><input type="number" name="batch_size" value="<%= defaults.batch_size %>" min="0"></div>
        <div><label>Pause after each batch <small>(sec)</small></label><input type="number" name="batch_pause" value="<%= defaults.batch_pause %>" min="0"></div>
      </div>
      <div class="help">A random delay between min and max is used for every message; after each batch the sender pauses. The global daily cap in Settings also applies. Defaults are conservative on purpose.</div>
      <div class="row">
        <div><label>Send window start <small>(optional)</small></label><input type="time" name="send_window_start"></div>
        <div><label>Send window end</label><input type="time" name="send_window_end"></div>
      </div>
      <div class="help">Only send between these times (server timezone in Settings). Outside the window the campaign waits.</div>
    </div>

    <div class="card">
      <h2>When to send</h2>
      <label><input type="radio" name="when" value="now" checked> Start now</label>
      <label><input type="radio" name="when" value="schedule"> Schedule for</label>
      <input type="datetime-local" name="scheduled_at" id="scheduledAt">
      <label><input type="radio" name="when" value="draft"> Save as draft</label>
      <div style="margin-top:18px" class="actions">
        <button class="btn" type="submit">Create campaign</button>
        <a class="btn sec" href="/campaigns/new">← Back</a>
      </div>
    </div>
  </div>
</div>
</form>
<script>window.__compose = { sheetId: <%- JSON.stringify(sheetId) %> };</script>
<%- include('partials/footer') %>
